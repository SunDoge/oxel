struct Layout {
    width: i32,
    height: i32,
}

struct Window {
    title: string,
    layout: Layout,
}

fn main() {
    let title = "Oxel";
    let original = Window {
        title,
        layout: Layout { width: 640, height: 480 },
    };
    let layout = Layout { width: 800, ..original.layout };
    let updated = Window { layout, ..original };

    let Window { title, layout: Layout { width, .. } } = updated;
    System.Console.WriteLine(title);
    System.Console.WriteLine(width);
    System.Console.WriteLine(original.layout.width);
}
