use System::{Action, Func};

fn main() -> i32 {
    let view: Func<i32, i32[], Action<i32, i32, i32, string, bool>, i32> = |count, events, draw| {
        counter(count, events, draw)
    };
    let mut count = 0;
    run_counter(0) |address, len| {
        if let Some(next) = render_counter(count, counter_events(address, len), view) {
            count = next;
            0
        } else {
            1
        }
    }
}
