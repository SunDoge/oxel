fn main(args: string[]) -> i32 {
    if args.Length != 1 {
        System.Console.WriteLine("Usage: file_lines <path>");
        return 2;
    }

    let path = args[0];
    if !System.IO.File.Exists(path) {
        System.Console.WriteLine($"File not found: {path}");
        return 1;
    }

    let lines = System.IO.File.ReadAllLines(path);
    let nonempty = new System.Collections.Generic.List<string>();
    for line in lines {
        if line.Trim().Length > 0 {
            nonempty.Add(line);
        }
    }
    System.Console.WriteLine(System.IO.Path.GetFileName(path));
    System.Console.WriteLine(nonempty.Count.ToString());
    0
}
