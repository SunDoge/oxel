fn identity<T>(value: T) -> T {
    value
}

fn main() {
    let messages = new System.Collections.Generic.List<string?>();
    messages.Add(null);
    messages.Add("ready");

    System.Console.WriteLine(identity(messages[0]) ?? "missing");
    System.Console.WriteLine(messages[1] ?? "missing");

    let empty = System.Array.Empty::<string?>();
    System.Console.WriteLine(empty.Length);
}
