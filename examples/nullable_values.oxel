fn with_default<T: struct>(value: T?, fallback: T) -> T {
    unwrap_or(value, fallback)
}

fn lookup(found: bool) -> i32? {
    if found {
        30
    } else {
        null
    }
}

fn main() {
    let values = [lookup(true), lookup(false)];
    for value in values {
        System.Console.WriteLine(with_default(value, -1));
    }
}
