const MODE: System.StringComparison = System.StringComparison.OrdinalIgnoreCase;
const IS_ORDINAL = MODE == System.StringComparison.OrdinalIgnoreCase;

fn matches(left: string, right: string, comparison: System.StringComparison) -> bool {
    left.Equals(right, comparison)
}

fn main() {
    System.Console.WriteLine(matches("oxel", "OXEL", MODE));
    System.Console.WriteLine(IS_ORDINAL);
    System.Console.WriteLine(MODE.ToString());
}
