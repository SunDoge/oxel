fn mount_counter(panel: Avalonia.Controls.StackPanel) {
    let mut count = 0;
    mount(panel) |ui| {
        text(ui, "count", $"Count: {count}");
        row(ui, "actions") |actions| {
            button(actions, "decrement", "Decrement", true) { count -= 1; };
            button(actions, "reset", "Reset", count != 0) { count = 0; };
            button(actions, "increment", "Increment", true) { count += 1; };
        };
    };
}

fn counter_window() -> Avalonia.Controls.Window {
    let panel = new Avalonia.Controls.StackPanel();
    panel.Margin = new Avalonia.Thickness(24.0);
    panel.Spacing = 16.0;
    mount_counter(panel);

    let window = new Avalonia.Controls.Window();
    window.Title = "oxel Counter";
    window.Width = 360.0;
    window.Height = 180.0;
    window.MinWidth = 340.0;
    window.MinHeight = 160.0;
    window.Content = panel;
    window
}

fn main(args: string[]) -> i32 {
    let lifetime = new Avalonia.Controls.ApplicationLifetimes.ClassicDesktopStyleApplicationLifetime();
    let builder = Avalonia.AppBuilder.Configure::<Avalonia.Application>();
    let desktop = Avalonia.AppBuilderDesktopExtensions.UsePlatformDetect(builder);
    desktop.AfterSetup() |setup| {
        if let Some(app) = setup.Instance {
            app.Styles.Add(new Avalonia.Themes.Fluent.FluentTheme());
        }
    };
    desktop.SetupWithLifetime(lifetime);
    lifetime.MainWindow = counter_window();
    lifetime.Start(args)
}
