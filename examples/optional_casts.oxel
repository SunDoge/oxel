fn read<T>(value: object?) -> Option<T> {
    value as? T
}

fn next(value: object?) -> Option<i32> {
    let number = (value as? i32)?;
    Option.Some(number + 1)
}

fn load() -> object {
    System.Console.WriteLine("read once");
    29
}

fn main() {
    System.Console.WriteLine(unwrap_or(next(load()), 0));
    System.Console.WriteLine(unwrap_or(read::<string>("oxel"), "missing"));
    System.Console.WriteLine(unwrap_or((29 as? i64), 0));
    System.Console.WriteLine(unwrap_or((null as? string), "missing"));
}
